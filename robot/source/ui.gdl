;;;;
;;;; Web UI on the shared demo chrome (demos-common:demo-ui-mixin):
;;;; this file keeps only the robot-specific page content, form
;;;; controls, and model hookup.  session-control-mixin keeps public
;;;; instances mortal: without it every visit and every crawler hit
;;;; mints an immortal instance.

(in-package :robot-demo)

(define-object robot-ui (demos-common:demo-ui-mixin
                         session-control-mixin base-html-page)

  :documentation
  (:description "Interactive robot demo page: the classic GDL robot
example (2002) hosted in the 2026 demo framework -- pose the robot
live with form controls."
   :author "Genworks International")

  :input-slots
  ((title "Robot Assembly Demo")
   (demo-slug "robot")
   (objects (list (the model)))
   (view-projection-key :robot-view)
   (view-projection-vector (unitize-vector (make-vector 0.7 -1 0.45)))

   (robot-height 10 :settable)
   (robot-width 5 :settable)
   (robot-length 2 :settable)
   (head-angle 0 :settable)
   (body-angle 20 :settable)
   (arm-angle-left 0 :settable)
   (arm-angle-right 0 :settable)
   (pincer-distance-left 0.45 :settable)
   (pincer-distance-right 0.45 :settable))

  :computed-slots
  ((source-pane-objects '(robot robot-body robot-arm robot-base robot-ui
                          demos-common:demo-ui-mixin))

   (body
    (with-lhtml-string ()
      (:div :class "max-w-5xl mx-auto p-8"
        (str (the (page-intro "Robot Assembly"
                              "The classic GDL robot example, reborn in the 2026 demo framework -- pose it live.")))
        (str (the (card :title "Parameters"
                        :content (with-lhtml-string ()
                                   (:div :class "p-6"
                                     (str (the control-form)))))))
        (str (the (card :title "3D View"
                        :content (with-lhtml-string ()
                                   (:div :class "p-6 relative" :style "height: 600px;"
                                     (str (the viewport-area div)))))))
        (str (the (card :title "About This Demo"
                        :content (with-lhtml-string ()
                                   (:div :class "px-6 py-4 text-sm text-gray-700 space-y-2"
                                     (:p "This robot first appeared in 2002 as the introductory GDL
training example: a handful of box primitives composed with declarative
positioning and orientation rules.")
                                     (:p "The geometry definitions below are essentially the 2002
originals.  Only the user interface is new -- form-control objects, an
x3dom viewport, and session-controlled instances replace the old
html-format lens."))))))
        (str (the (card :title "Source Code"
                        :subtitle "The complete Gendl source for this demo, reconstituted live from the in-memory object definitions serving this page."
                        :content (the source-code-panes)))))))

   (control-form
    (with-form-string (:class "grid grid-cols-2 md:grid-cols-4 gap-6")
      (str (the (param-field "Height"           (the height-control))))
      (str (the (param-field "Width"            (the width-control))))
      (str (the (param-field "Length"           (the length-control))))
      (str (the (param-field "Torso"            (the torso-control))))
      (str (the (param-field "Head Angle (deg)" (the head-angle-control))))
      (str (the (param-field "Body Angle (deg)" (the body-angle-control))))
      (str (the (param-field "Left Arm (deg)"   (the arm-angle-left-control))))
      (str (the (param-field "Right Arm (deg)"  (the arm-angle-right-control))))
      (str (the (param-field "Left Grip"        (the pincer-left-control))))
      (str (the (param-field "Right Grip"       (the pincer-right-control)))))))

  :objects
  ((height-control :type 'number-form-control
                   :default (the robot-height)
                   :ajax-submit-on-change? t
                   :domain :number :min 4 :max 20 :step 1)

   (width-control :type 'number-form-control
                  :default (the robot-width)
                  :ajax-submit-on-change? t
                  :domain :number :min 3 :max 10 :step 0.5)

   (length-control :type 'number-form-control
                   :default (the robot-length)
                   :ajax-submit-on-change? t
                   :domain :number :min 1 :max 4 :step 0.5)

   (torso-control :type 'menu-form-control
                  :default :box
                  :size 1
                  :ajax-submit-on-change? t
                  :choice-plist '(:box "Box" :cylinder "Cylinder"))

   (head-angle-control :type 'number-form-control
                       :default (the head-angle)
                       :ajax-submit-on-change? t
                       :domain :number :min -90 :max 90 :step 5)

   (body-angle-control :type 'number-form-control
                       :default (the body-angle)
                       :ajax-submit-on-change? t
                       :domain :number :min -90 :max 90 :step 5)

   (arm-angle-left-control :type 'number-form-control
                           :default (the arm-angle-left)
                           :ajax-submit-on-change? t
                           :domain :number :min -180 :max 180 :step 5)

   (arm-angle-right-control :type 'number-form-control
                            :default (the arm-angle-right)
                            :ajax-submit-on-change? t
                            :domain :number :min -180 :max 180 :step 5)

   (pincer-left-control :type 'number-form-control
                        :default (the pincer-distance-left)
                        :ajax-submit-on-change? t
                        :domain :number :min 0 :max 1 :step 0.05)

   (pincer-right-control :type 'number-form-control
                         :default (the pincer-distance-right)
                         :ajax-submit-on-change? t
                         :domain :number :min 0 :max 1 :step 0.05)

   (model :type 'robot
          :height (the height-control value)
          :width (the width-control value)
          :length (the length-control value)
          :torso-type (ecase (the torso-control value)
                        (:box 'box) (:cylinder 'cylinder))
          :head-angle (the head-angle-control value)
          :body-angle (the body-angle-control value)
          :arm-angle-left (the arm-angle-left-control value)
          :arm-angle-right (the arm-angle-right-control value)
          :pincer-distance-left (the pincer-left-control value)
          :pincer-distance-right (the pincer-right-control value)
          :transparency 0
          :shininess 0.8)))
