(in-package :house-ui)

(define-object assembly (base-ajax-graphics-sheet geysr:assembly) ;;(base-ajax-graphics-sheet)

  :input-slots ((title "Roofless House Design") 
                (image-format-default :svg)
                ;;(image-format-default :x3dom)
                )
  
  
  :computed-slots
  (

   (use-x3dom? t)
   (additional-header-content
    (with-cl-who-string ()
      ((:meta :charset "UTF-8"))
      ((:meta :name "viewport" :content "width=device-width, initial-scale=1.0"))
      (:title "Document")
      ((:link :href "/house-static/tailwind.css" :rel "stylesheet"))
      ((:link :href "/house-static/styles.css" :rel "stylesheet"))
      ((:link :href "/geysr-static/menu.css" :rel "stylesheet"))

      ))


   (use-svgpanzoom? t)
   (x3dom? (eql (the viewport image-format-selector value) :x3dom))


   (respondent self)
   (resize-callback (format nil "gdlResize('~a');" (the root-path)))
   (body-onpageshow (unless (the x3dom?) (the resize-callback)))
   (body-onresize (unless (the x3dom?) (the resize-callback)))
   (body-onpageload (unless (the x3dom?) (the resize-callback)))

   (menu-included-children (list :view))
   (menu-div-class "popup-menu")

   (menu-clear-func #'(lambda()
                        ()))

   (viewport-dimensions (list :width 500  :length 500) :settable)   


   (svg-class "rounded-lg")

   (main-sheet-body  (with-cl-who-string ()
                       (str (the development-links))
                       ((:div :class "gridfoo")
                        ((:div :class "cell title")
                         ((:h2 :class "text-2xl font-bold leading-7 text-blue-800 sm:text-3xl sm:truncate")
                          (str (the title))))
                        ((:div :class "cell inputs")(str (the inputs-section main-div)))

                        ((:div :class "cell viewport" :id "viewport")
			 (str (the viewport main-div)))

                        ((:div :class "cell table")(str (the table-section main-div)))
                        
			((:div :id "menu-script")
			 (str (the menu main-div))
			 (str (the menu-script main-div)))
			
			((:div :id "viewport-script" :style "display: none;")
			 (str (the viewport-script main-div)))

                        
                        ;;((:div :id "viewport" :class "cell viewport")(str (the viewport-section main-div)))
                        
                        
                        )))


   (table-data (list (list :heading "Number of Bricks"
                           :value (the total-number-of-bricks))
                     (list :heading "Total Cost"
                           :value (format nil "$~$"  (the total-cost-bricks)))
                     (list :heading "Brick Volume"
                           :value (format nil "~a cubic inches"  (the total-volume-bricks)))
                     (list :heading "Mortar Volume"
                           :value (format nil "~a cubic inches" (the total-volume-mortar)))))
   
   (vector-graphics-onclick? nil)
   (display-list-object-roots (list (the house)))
   ;;(length 500) (width 500)
   (background-color "#ffffff")
   (view-direction-default :trimetric)

   (total-number-of-bricks (the house total-number-of-bricks))
   (total-cost-bricks (the house total-cost-bricks))
   (total-volume-bricks (the house total-volume-bricks))
   (total-volume-mortar (the house total-volume-mortar)))


  :objects

  
  (

   #+nil
   (deck :type 'deck:assembly
         :length (the length-input value)
         :width (the width-input value))


   (house :type 'house:assembly
          :wall-length (the length-input value)
          :wall-width (the width-input value)
          :wall-height (the height-input value))
   
   (inputs-section :type 'sheet-section
                   :inner-html (with-cl-who-string ()
                                 ((:div
                                   :class "ml-3 mr-3 rounded-lg bg-blue-800 shadow-lg flex flex-col \border-b border-gray-100 p-6 text-center sm:border-0 sm:border-r")
                                  ;;sm-border-0
                                  
                                  (dolist (input (list (the length-input) (the height-input) (the width-input)))
                                    (htm
                                     (:div
                                      ((:label :for (the-object input id)
                                               :class "text-lg font-bold ml-1 block text-sm font-medium text-white")
                                       (str (the-object input prompt)))
                                      ((:div :class "mt-1 ml-1") (str (the-object input form-control-string))))))

                                  ((:div :class "mt-5 ml-1") (str (the submit-button form-control-string)))
                                  ((:div :class "mt-8 ml-1") (str (the view-selector form-control-string)))
                                   
                                  ;;(:p ((:span :class "relative inline-block text-left")(str (the view-selector html-string))))
                                 
                                  )))

   (length-input :type 'number-form-control :default 3 :class "text-lg rounded-lg" :prompt "Length")
   (width-input :type 'number-form-control :default 50 :class "text-lg rounded-lg" :prompt "Width")
   (height-input :type 'number-form-control :default 15 :class "text-lg rounded-lg" :prompt "Height")
   (submit-button :type 'button-form-control :prompt " OK " :class "text-white bg-green-600 hover:bg-green-700 btn"
                  :onclick (the (gdl-ajax-call :form-controls (list (the length-input)
                                                                    (the height-input)
                                                                    (the width-input)))))
   (view-selector :type 'menu-form-control
                  :size 1
                  :prompt "View"
                  :class "rounded-lg"
                  :onchange (the (gdl-ajax-call :form-controls (list (the-child))))
                  :choice-list (plist-keys (the standard-views))
                  :default (the view-direction-default))

   #+nil
   (viewport-section :type 'sheet-section
		     :inner-html (with-cl-who-string ()
                                   (str (the viewport main-div))
                                   (str (the viewport-script main-div))
                                   #+nil
                                   (ecase (the image-format-selector value)
                                     ((:png :jpg) (str (the raster-graphics)))
                                     (:svg (str (the svg-string)))
                                     (:x3dom (str (the x3dom-graphics))))))

   (viewport-script :type 'sheet-section
		    :js-to-eval :parse
		    :inner-html (the viewport viewport-script))
   
                                     

   (table-section :type 'sheet-section
                  :inner-html (with-cl-who-string ()
                                ((:div :class "flex flex-col")
                                 ((:div :class "my-2 overflow-x-auto sm:-mx-6 lg:-mx-8")
                                  ((:div :class "py-2 align-middle inline-block min-w-full sm:px-6 lg:px-8")
                                   ((:div :class "shadow overflow-hidden border-b border-gray-200 sm:rounded-lg bg-blue-800")
                                    
                                    ((:table :class "min-w-full divide-y divide-gray-200")
                                     ((:thead :class "bg-gray-50")
                                      (:tr
                                       (dolist (column (the table-data))
                                         (let ((heading (getf column :heading)))
                                           (htm
                                            ((:th :scope "col" :class
                                                  "px-6 py-3 text-left text-xs font-medium  text-white uppercase tracking-wider")
                                             (str heading))))))
                                      ((:tr :class "bg-white")
                                       (dolist (column (the table-data))
                                         (let ((value (getf column :value)))
                                           (htm
                                            ((:td :class "px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900")
                                             (str value))))))))))))))

   (viewport :type 'geysr:viewport
             :display-list-object-roots (the display-list-object-roots)
	     :view-direction-default :trimetric
	     :image-format-default (the image-format-default)
	     :image-format-plist (list :png "PNG image"
				       :jpeg "JPEG image"
				       :x3dom "Shaded"
				       ;;:web3d "VRML/X3D"
				       :svg "Wireframe")
	     
	     :empty-display-list-message (with-cl-who-string ()
					   (:p (:h2 (fmt "Viewport Display-List is currently empty."))))

	     :div-style "height: 100%; width: 100%"
	     :geysr self
	     :div-class "viewport-wrapper"
	     :root-object self
	     ;;:length (the length)
	     ;;:width (the width)
             :length (if (the x3dom?) "100%" (getf (the viewport-dimensions) :length))
	     :width (if (the x3dom?) "100%" (getf (the viewport-dimensions) :width))

	     :onclick-function nil
	     :background-color (the background-color)
	     )



   ))
                               
   
                               
  
#+nil
(define-lens (html-format assembly)()
  :output-functions
  (("Void. Writes an embedded X3D tag and included content for the <tt>view-object</tt> child of this object. 
The <tt>view-object</tt> child should exist and be of type <tt>web-drawing</tt>."

    embedded-x3dom-world
    (&key (include-view-controls? nil))
    
    (declare (ignore include-view-controls?))
    
    ;; (the (restore-slot-default! :js-to-eval))
    
    (with-cl-who ()
      
      (when (typep (the :view-object) 'null-part)
        (error "A valid :view-object of type web-drawing is required in the sheet 
to call the :write-embedded-x3d-world function."))
          
      (cond ((the no-graphics?)
             (htm
              ((:div :id "empty-viewport" :class "empty-viewport")
               (str (the empty-display-list-message)))))
            (t
             (let ((*display-controls* (the display-controls-hash)))
               (htm
                ((:span :id "x3d-viewport")
                 ((:|X3D| :id "x3dom-1" :style "background: #d3d3d3"
                    :width (if (numberp (the width)) (format nil "~apx" (the width)) (the width))
                    :height (if (numberp (the length)) (format nil "~apx" (the length)) (the length)))
                  (:|Scene|
                     
                    ((:|navigationinfo| :|id| "navi" :|transitionTime| "0.0"
                       ))
                     
                     
                    (with-format (x3d *stream*) 
                      (let ((*onclick-function* (the onclick-function)))
                        (write-the view-object cad-output)))))
                 
                 )
                ))))))))
