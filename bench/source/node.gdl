(in-package :bench)

(define-object node (base-object)

  :input-slots ((model-parameters *model-A*) (painted? t :defaulting))

  :trickle-down-slots (painted?)
  
  :objects
  ((product :type 'product
	    :parameters (the model-parameters))


   (process :type 'process-object
	    :after (the product))
   ))



(defparameter *model-A*
  (list :width 66 :length (+ 27 1/2) :height 25 :armrest-overhang 3/2
	:back-height 19 :back-crossmember-spread 15
	:recline-angle-degrees 15 :base-plank-type '2x4 :back-plank-type '2x4 :back-offset 0))


