(in-package :bench)

(defmethod before-types ((self t) (chosen-identifier t)) nil)

(defmethod before-input-plists ((self t) (chosen-identifier t)) nil)


;; Product Painting

(defmethod before-types ((self product)(chosen-identifier (eql :painting)))
  (when (the painted?) (list (the type))))

(defmethod before-input-plists ((self product) (chosen-identifier (eql :painting)))
  (when (the painted?)
    (list
     (append (list :painted? nil :display-controls (list :color :tan))
	     (remove-plist-keys (inputs-from self) (list :painted? :display-controls))))))



;; Product Assembly

(defmethod before-types ((self product)(chosen-identifier (eql :assembly)))
  (list (the base type) (the (back 1) type)))

(defmethod before-input-plists ((self product) (chosen-identifier (eql :assembly)))
  (list (inputs-from (the base))
	     (let ((center (the (back 1) center)))
	       (append
		(list :center (translate-along-vector center
						      (the (face-normal-vector :top)) 10))
		(remove-plist-key (inputs-from (the (back 1))) :center)))))


;; Planked-base Assembly

(defmethod before-types ((self planked-base)(chosen-identifier (eql :assembly)))
  (list (the frame type) (the planking type)))


(defmethod before-input-plists ((self planked-base)(chosen-identifier (eql :assembly)))
  (list (inputs-from (the frame)) (inputs-from (the planking))))


;;
;; base-frame Assembly
;;
(defmethod before-types ((self base-frame)(chosen-identifier (eql :assembly)))
  (append (list-elements (the rails) (the-element type))
	  (list-elements (the crossmembers) (the-element type))
	  (list-elements (the leg-assys) (the-element type))))
	  


(defmethod before-input-plists ((self base-frame)(chosen-identifier (eql :assembly)))
  (append (mapcar #'inputs-from (list-elements (the rails)))
	  (mapcar #'inputs-from (list-elements (the crossmembers)))
	  (mapcar #'inputs-from (list-elements (the leg-assys)))))
	  

;;
;; Planked-back Assembly
;;
(defmethod before-types ((self planked-back)(chosen-identifier (eql :assembly)))
  (list (the frame type) (the planking type)))


(defmethod before-input-plists ((self planked-back)(chosen-identifier (eql :assembly)))
  (list (inputs-from (the frame))
	(let ((center (the planking center)))
	  (append (list :center (translate-along-vector center
							(the (face-normal-vector :top)) 10))
		  (remove-plist-key (inputs-from (the planking)) :center)))))


;;
;; back-frame Assembly
;;
(defmethod before-types ((self back-frame)(chosen-identifier (eql :assembly)))
  (append (list-elements (the ends) (the-element type))
	  (list-elements (the crossmembers) (the-element type))
	  (list-elements (the rails) (the-element type))))
	  


(defmethod before-input-plists ((self back-frame)(chosen-identifier (eql :assembly)))
  (append (mapcar #'inputs-from (list-elements (the ends)))
	  (mapcar #'inputs-from (list-elements (the crossmembers)))
	  (mapcar #'inputs-from (list-elements (the rails)))))
	  

;;
;; Planking assembly
;;

(defmethod before-types ((self planking:planked-surface)(chosen-identifier (eql :assembly)))
  (list-elements (the planks) (the-element type)))
	  

(defmethod before-input-plists ((self planking:planked-surface)(chosen-identifier (eql :assembly)))
  (mapcar #'inputs-from (list-elements (the planks))))


;;
;; Rail cutting
;;

(defmethod before-types ((self 2x4)(chosen-identifier (eql :cutting)))
  (when (the cut?) (list '2x4-8ft)))

(defmethod before-input-plists ((self 2x4)(chosen-identifier (eql :cutting)))
  (when (the cut?)
    (list (append (list :center +nominal-origin+)
		  (remove-plist-keys (inputs-from self) (list :length :center))))))
	  


