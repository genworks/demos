(in-package :bench)

#+nil
(define-object plank-samples (base-object)


  :computed-slots ((length 17 :settable) (width 15) (height 3))
  
  :objects
  ((ref-box :type 'box)
   
   (planking :type 'planking:planked-surface
	     :display-controls (list :color :brown)
	     :plank-type 'lumber:2x6
	     :perimeter (let* ((p1 (the (vertex :top :left :front)))
			       (p2 (the (vertex :top :left :rear)))
			       (p3 (the (vertex :top :right :rear)))
			       (p4 (the (vertex :top :right :front)))
			       (p5 p1))
			  (list p1 p2 p3 p4 p5)))))

