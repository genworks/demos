(gwl:define-package :planking (:export #:planked-surface))

(in-package :planking)

(define-object planked-surface (base-object)

  :input-slots ((p-plane (the (face-center :top)))
		(u-plane (the (face-normal-vector :top)))

		;;
		;; FLAG - replace p-plank and u-plank with full perimeter.
		;;
		(p-plank (the (face-center :front)))
		(u-plank (the (face-normal-vector :right)))

		(u-front (cross-vectors (the u-plank) (the u-plane)))
		
		(plank-type 'lumber:2x4)
		(spacing-nominal 1/4)
		;; FLAG -- input perimeter polygon.

		;;
		;; FLAG -- pass in the below until we do full perimeter polygon. 
		;;
		(shorter-plank-indices nil)
		(shorter-plank-length (the width))
		(longer-plank-length (the width))

		;;
		;; FLAG -- only symmetrical perimeters working for now.
		;;         allow assymetrical.
		;;
		;; FLAG -- only planks running left-to-right supported
		;;         for now.  allow planks to run in arbitrary
		;;         direction, and handle angle cuts. 
		;;
		;;
		(perimeter nil)
		
		)


  :computed-slots ((spacing (let ((available-length (- (the length)
						       (* (the planks first width)
							  (1- (the planks number-of-elements)))))
				  (number-of-spaces (- (the planks number-of-elements) 2)))
			      (/ available-length number-of-spaces)))

		   (number-of-planks 
		    (1+ (floor (/ (+ (the length) (the spacing-nominal))
				  (+ (the spacing-nominal)
				     (the-object (make-object (the plank-type)) width)))))))


  :objects ((planks :type (the plank-type)
		    :sequence (:size (the number-of-planks))

		    :datum (the planks first)
		    :datum? (the-child first?)
		    :rear (the planks last)
		    :front (the (planks 1))

		    :pseudo-inputs (datum datum? rear front center* length-and-center
                                          mid-point)
		    
		    :length-and-center
                    (if (the perimeter)
                        (let ((bounds (the (perimeter-bounds (the-child center*)))))
                          (destructuring-bind (start end) bounds
                            (list :length (3d-distance start end)
                                  :center (make-point (get-x (midpoint start end))
                                                      (get-y (the-child center*))
                                                      (get-z (the-child center*))))))
                        (list :length
                              (if (member (the-child index) (the shorter-plank-indices))
                                  (the shorter-plank-length) (the longer-plank-length))
                              :center (the-child center*)

                              ))

                    :length (getf (the-child length-and-center) :length)
                    :center (getf (the-child length-and-center) :center)
		    
		    :hidden? (the-child datum?)
		    :orientation (alignment :top (the u-plane) :rear (the u-plank))
		    ;;
		    ;; FLAG -- compute center based on perimeter and length.
		    ;;
		    :center* (cond ((the-child datum?) (the center))
				   ((eql (the-child) (the-child front))
				    (let* ((z-center
                                             (flush-center (the center)
                                                           (the-child datum
                                                                      (face-center :bottom))
                                                           (the p-plane) (the u-plane)))
					   (p-plank (if (the perimeter)
							(let ((y-min
                                                                (least #'get-y
                                                                       (the perimeter))))
							  (inter-line-plane 
                                                           z-center
                                                           (the (face-normal-vector :front))
                                                           y-min (the (face-normal-vector
                                                                       :front))))
							(the p-plank))))
				      (flush-center z-center
                                                    (the-child datum
                                                               (face-center :right))
                                                    p-plank (the u-front))))
				   (t (translate (the-child previous center)
						 :rear
						 (+ (the-child width) (the spacing)))))))

                                        

  :functions
  ((perimeter-bounds
    (point)
    (setq point (make-point (get-x point) (get-y point) 0))
    (let* ((intersects (remove
			nil
			(mapcar #'(lambda(a b)
				    (setq a (make-point (get-x a) (get-y a) 0))
				    (setq b (make-point (get-x b) (get-y b) 0))
				    (inter-line-segment point
                                                        (the (face-normal-vector :right))
							a b))
				(the perimeter) (rest (the perimeter)))))
	   (x-min (least #'get-x intersects))
	   (x-max (most #'get-x intersects)))
      (list x-min x-max)))))

;;
;; FLAG -- promote this to a geom-base utility, or make it
;;         a local :function here in the above object def. 
;;
(defun inter-line-segment (p-line u-line a b)
  (let ((u-segment (subtract-vectors b a)))
  (let ((possible (inter-line-line p-line u-line a u-segment)))
    (when (and possible
	       (same-direction-vectors? u-segment (subtract-vectors possible a))
	       (< (3d-distance possible a) (3d-distance a b)))
      possible))))

  





