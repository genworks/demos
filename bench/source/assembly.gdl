(in-package :bench)

(define-object assembly (base-object)

  :input-slots ((width 66) (length (+ 27 1/2)) (height 25) (armrest-overhang 3/2)
		(back-height 19) (back-crossmember-spread 15) (recline-angle-degrees 15))

  :computed-slots ((display-controls (list :color :orange)))

  :objects ((base :type 'planked-base
		  :plank-type '2x4
		  :pass-down (armrest-overhang))
	    
	    (back :type 'planked-back
		  :sequence (:size 2)
		  :datum (the back first)
		  :datum? (the-child first?)
		  :hidden? (the-child datum?)
		  :pseudo-inputs (datum datum?)
		  :crossmember-spread (the back-crossmember-spread)
		  :width (- (the width) (the base frame legs-width))
		  :length (the back-height)
		  :height (the-object (make-object (the-child plank-type)) width)
		  :display-controls (list :color :green)
		  :pass-down (recline-angle-degrees)
		  :plank-type '2x4
		  :center (if (the-child datum?) (the center)
			      (flush-center
			       (flush-center
				(the-child datum center) (the-child datum frame rails front (face-center :bottom))
				(the base planking planks last (face-center :top)) (the (face-normal-vector :top)))
			       (the-child datum frame rails front (face-center :right))
			       (the base planking planks last (face-center :left)) (the (face-normal-vector :rear))))

		  :orientation (alignment :top (rotate-vector-d (the (face-normal-vector :top)) (- 90 (the recline-angle-degrees))
								(the (face-normal-vector :right)))))))



