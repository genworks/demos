(gwl:define-package :lumber (:export #:angle-cut-2x4 #:1x4 #:2x4 #:2x6 #:4x4
				     #:2x4-8ft))

(in-package :lumber)

(define-object 4x4 (box)
  :computed-slots
  ((width (+ 1/2 3))
   (height (+ 1/2 3))))

				      
(define-object 2x4 (box)
  :computed-slots
  ((cut? t)
   (width (+ 1/2 3))
   (height (+ 1/2 1))))


(define-object 2x6 (box)
  :computed-slots
  ((cut? t)
   (width (+ 1/2 5))
   (height (+ 1/2 1))))


(define-object 2x4-8ft (2x4)
  :computed-slots ((cut? nil)
		   (length (* 8 12))))


(define-object 1x4 (box)
  :computed-slots
  ((width (+ 1/2 3))
   (height 1/2)))

;;
;; FLAG move to tests area.
;; 
(define-object test-angle-cut-2x4 (angle-cut-2x4)

  :computed-slots
  ((display-controls (list :color :green))
   (offset :down)
   (length 19)
   (front-angle-degrees 15)))


(define-object angle-cut-2x4 (global-polygon-projection 2x4)

  :objects ((original :type 'box :hidden? t))
  
  :input-slots ((front-angle-degrees 0) (rear-angle-degrees 0))

  :computed-slots
  ((offset :down)
   (projection-depth (the height))
   (vertex-list (list (the (vertex :bottom :front :right))
		      (let ((p-line (the (vertex :bottom :front :right)))
			    (u-line (rotate-vector-d (the (face-normal-vector :left))
						     (the front-angle-degrees)
						     (the (face-normal-vector :bottom))))
			    (p-plane (the (vertex :bottom :front :left)))
			    (u-plane (the (face-normal-vector :left))))
			(let ((intersect (inter-line-plane p-line u-line p-plane u-plane)))
			  (translate-along-vector p-line (subtract-vectors intersect p-line)
						  (3d-distance intersect p-line))))
		      (the (vertex :bottom :rear :left)) (the (vertex :bottom :rear :right))))))
