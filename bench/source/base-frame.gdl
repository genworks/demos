(in-package :bench)

(define-object base-frame (base-object)

  :input-slots
  ((width (+ 59 7))
   (length (+ 27 1/2))
   (height 25)
   (armrest-overhang 3/2))


  :computed-slots ((display-controls (list :color :brown)))
  
  :objects
  ((rails :type '2x4
	  :sequence (:size 2)
	  :side (ecase (the-child index) (0 :front) (1 :rear))
	  :pseudo-inputs (side)
	  :length (- (the width)
		     (sum-elements (the leg-assys) (the-element length)))

	  :orientation (alignment :rear (the (face-normal-vector :right))
				  :right (the (face-normal-vector :top)))
	  :center (translate (the (edge-center :front :bottom))
			     :up (+ 1/2 13 (half (the-child width)))
			     :rear (ecase (the-child side)
				     (:front (+ (the armrest-overhang)
						(half (the-child height))))
				     (:rear (- (the length)
					       (half (the-child height)))))))


   (crossmembers :type '2x4
		 :sequence (:size 3)
		 :length (- (3d-distance (the (rails 0) center)
					 (the (rails 1) center))
			    (half (+ (the (rails 0) height)
				     (the (rails 1) height))))

		 :orientation (alignment :top (the (face-normal-vector :right)))
		 

		 :center (translate (midpoint (the (rails 0) center) (the (rails 1) center))
				    :left
				    (ecase (the-child index)
				      (0 (- (/ (the width) 4)))
				      (1 0)
				      (2 (/ (the width) 4)))))

		 

   (leg-assys :type 'leg-assy
              :sequence (:size 2)
	      :side (ecase (the-child index) (0 :left) (1 :right))
	      :pseudo-inputs (side)
	      
	      :orientation (alignment :top (the (face-normal-vector :top))
				      :rear (the (face-normal-vector (the-child side)))
				      :left (the (face-normal-vector :front)))
	      
	      :center
	      (let ((start-center (the (face-center (the-child side)))))
		(translate-along-vector start-center
					(subtract-vectors (the center) start-center)
					(half (the-child length))))
	      :pass-down (armrest-overhang)
	      :width (the length)
	      :length (+ 1/2 3)
	      :height (the height))))

(define-object leg-assy (box)

  :input-slots
  ((length (+ 1/2 3))
   (width (+ 27 1/2))
   (height 25)
   (armrest-overhang 3/2)
   (display-controls (list :color :tan) :defaulting)
   )

  
  :objects
  (;;(bbox :type 'box)

   (armrest :type '2x4
	    :length (+ 1/2 27)
	    :orientation (alignment :top (the (face-normal-vector :top))
				    :right (the (face-normal-vector :rear)))
	    :center (translate (the (face-center :top))
			       :down (half (the-child height))))

   (cross-member :type '2x4
		 :length (3d-distance (the (legs 0) (face-center :right))
				      (the (legs 1) (face-center :left)))
		 :center (translate (the (edge-center :bottom :rear))
				      :up (+ 1/2 13 (half (the-child width)))
				      :front (half (the-child height))
				      :right (half (the armrest-overhang)))
		 

		 :orientation (alignment :top (the (face-normal-vector :rear))
					 :rear (the (face-normal-vector :left))))
				      

   
   (legs :type '4x4
	 :sequence (:size 2)
	 :side (ecase (the-child index) (0 :left) (1 :right))
	 :pseudo-inputs (side)
	 :length (+ 1/2 23)
	 :orientation (alignment :rear (the (face-normal-vector :top))
				 :right (the (face-normal-vector :right)))
	 :center 
	 (let ((start-center (the (face-center (the-child side)))))
	   (translate start-center
		      :down (half (- (the height) (the-child length)))
		      (ecase (the-child side)
			(:left :right) (:right :left))
		      (ecase (the-child side)
			(:right (half (the-child height)))
			(:left (+ (the armrest-overhang)
				  (half (the-child height))))))))))



(define-object back-frame (base-object)

  :input-slots
  ((width (+ 3 56))
   (length 19)
   (height (+ 1/2 3))

   (display-controls (list :color :orange) :defaulting)
   )

  :objects
  ((ends :type '2x4 ;;flag replace with polygon-projections for cut
	 :sequence (:size 2)
	 :side (ecase (the-child index) (0 :left) (1 :right))
	 :pseudo-inputs (side)
	 :center (ecase (the-child side)
		   (:left (translate (the (face-center :left))
				     :right (half (the-child height))))
		   (:right (translate (the (face-center :right))
				      :left (half (the-child height)))))
	 :orientation (alignment :top (the (face-normal-vector :right))
				 :rear (the (face-normal-vector :rear))))


   (rails :type '2x4 
	  :sequence (:size 4)
	  :side (ecase (the-child index) (0 :datum) (1 :datum*) (2 :front) (3 :rear))
	  :datum (the (rails 0))
	  :datum* (the (rails 1))
	  :pseudo-inputs (side datum datum*)
	  :hidden? (case (the-child side)
		     ((:front :rear) nil)
		     (otherwise t))
	  :center (ecase (the-child side)
		    (:rear (translate (the (face-center :rear))
				      :front (half (the-child height))))
		    (:datum (translate (the (face-center :front))
				       :rear (half (the-child height))))
		    (:datum* (translate (the-child datum center)
				       :rear
				       (let ((datum (least #'get-y (the-child datum bounding-box))))
					 (3d-distance
					  datum
					  (inter-line-plane datum
							    (the (face-normal-vector :front))
							    (the (face-center :front))
							    (the (face-normal-vector :front)))))))
		    (:front (translate (the-child datum* center)
				       :top
				       (let ((datum (the-child datum*
							       (closest-vertex
								(the (:vertex :top :left :front))))))
					 (3d-distance
					  datum
					  (inter-line-plane datum
							    (the (face-normal-vector :top))
							    (the (face-center :top))
							    (the (face-normal-vector :top))))))))
									
					

		    

		    
	  :length (- (the width) (the (ends 0) height) (the (ends 1) height))
	  :orientation (alignment :top (rotate-vector-d (the (face-normal-vector :rear))
							(ecase (the-child side)
							  (:datum 15)
							  (:datum* 15)
							  (:front 15)
							  (:rear 0))
							(the (face-normal-vector :right)))
				  :rear (the (face-normal-vector :left))))

   ))
		   
	 
(define-object-amendment box ()
  :functions
  ((closest-vertex (point)
		   (least #'(lambda(vertex)
			      (3d-distance vertex point))
			  (list (the (:vertex :top :right :rear))
				(the (:vertex :top :left :rear))
				(the (:vertex :top :right :front))
				(the (:vertex :top :left :front))
				(the (:vertex :bottom :right :rear))
				(the (:vertex :bottom :left :rear))
				(the (:vertex :bottom :right :front))
				(the (:vertex :bottom :left :front)))))))
				


(define-object 4x4-test (box)
  :computed-slots
  ((length 23)
   (width (+ 1/2 3))
   (height (+ 1/2 3))))


(define-object 4x4 (box)
  :computed-slots
  ((width (+ 1/2 3))
   (height (+ 1/2 3))))

				      
(define-object 2x4 (box)
  :computed-slots
  ((width (+ 1/2 3))
   (height (+ 1/2 1))))							     
	      

