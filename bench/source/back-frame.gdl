(in-package :bench)

(define-object back-frame (base-object)

  :input-slots
  (width length height display-controls crossmember-spread recline-angle-degrees)

  :objects
  (

   (ends :type 'angle-cut-2x4 ;;flag replace with polygon-projections for cut
	 :front-angle-degrees (the recline-angle-degrees)
	 :rear-angle-degrees 0
	 :sequence (:size 2)
	 :side (ecase (the-child index) (0 :left) (1 :right))
	 :pseudo-inputs (side)
	 :center (ecase (the-child side)
		   (:left (translate (the (face-center :left))
				     :right (half (the-child height))))
		   (:right (translate (the (face-center :right))
				      :left (half (the-child height)))))
	 :orientation (alignment :top (the (face-normal-vector :left))
				 :rear (the (face-normal-vector :rear))))

   (crossmembers :type 'angle-cut-2x4
		 :sequence (:size 3)
		 :side (ecase (the-child index) (0 :datum) (1 :left) (2 :right))
		 :hidden? (case (the-child side) ((:left :right) nil) (:datum t))
		 :datum (the (crossmembers 0))
		 :pseudo-inputs (datum side)
		 :length (3d-distance (the (rails 3) (edge-center :left :top))
				      (the (rails 4) (edge-center :left :bottom)))
		 :pseudo-inputs (side)
		 :front-angle-degrees (the recline-angle-degrees)
		 :rear-angle-degrees 0
		 :sequence (:size 2)
		 :orientation (the (ends 0) orientation)
		 :center (ecase (the-child side)
			   (:datum (the center))
			   ((:left :right)
			    (translate (the center)
				       (the-child side)
				       (half (the crossmember-spread))
				       :rear
				       (distance-to-plane (the-child datum (face-center :rear))
							  (the (rails 4) (face-center :bottom))
							  (the (rails 4) (face-normal-vector :bottom)))))))


   (rails :type '2x4 
	  :sequence (:size 5)
	  :side (ecase (the-child index) (0 :datum) (1 :datum*) (2 :datum**) (3 :front) (4 :rear))
	  :datum (the (rails 0))
	  :datum* (the (rails 1))
	  :datum** (the (rails 2))
	  :front (the (rails 3))
	  :pseudo-inputs (side datum datum* datum** front)
	  :hidden?  (case (the-child side)
			   ((:front :rear) nil)
			   (otherwise t))
	  :center (ecase (the-child side)
		    (:rear (translate (the (face-center :rear))
				      :front (half (the-child height))))
		    (:datum (translate (the (face-center :front))
				       :rear (half (the-child height))))
		    (:datum* (flush-center (the-child datum center)
					   (least #'get-y (the-child datum bounding-box))
					   (the (face-center :front))
					   (the (face-normal-vector :rear))))
		    (:datum** (flush-center (the-child datum* center)
					    (the-child datum* (closest-vertex (the (:vertex :top :left :front))))
					    (the (face-center :top))(the (face-normal-vector :top))))
		    (:front (flush-center (the-child datum** center)
					  (the-child datum** (edge-center :left :top))
					  (the (face-center :top))
					  (the (face-normal-vector :top))
					  (the-child datum** (face-normal-vector :right)))))

	  :length (- (the width) (the (ends 0) height) (the (ends 1) height))
	  :orientation (alignment :top (rotate-vector-d (the (face-normal-vector :rear))
							(ecase (the-child side)
							  (:datum (the recline-angle-degrees))
							  (:datum* (the recline-angle-degrees))
							  (:datum** (the recline-angle-degrees))
							  (:front (the recline-angle-degrees))
							  (:rear 0))
							(the (face-normal-vector :right)))
				  :rear (the (face-normal-vector :left))))))


(define-object test-back-frame (back-frame)
  
  :computed-slots
  ((width (+ 3 56))
   (length 19)
   (height (+ 1/2 3))

   (display-controls (list :color :orange))
   (crossmember-spread 15)
   (recline-angle-degrees 15)))
