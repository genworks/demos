(in-package :bench)

(define-object product (base-object)

  :input-slots ((width 66 :settable) (length (+ 27 1/2) :settable)
		(height 25 :settable) (armrest-overhang 3/2 :settable)
		(back-height 19 :settable) (back-crossmember-spread 15 :settable)
		(recline-angle-degrees 15 :settable) (base-plank-type '2x4 :settable)
		(back-plank-type '2x4 :settable) (back-offset 0 :settable))

  :computed-slots ((display-controls (list :color :orange)))

  :objects ((base :type 'planked-base
		  :plank-type (the base-plank-type)
		  :pass-down (armrest-overhang))
	    
	    (back :type 'planked-back
		  :sequence (:size 2)
		  :datum (the back first)
		  :datum? (the-child first?)
		  :hidden? (the-child datum?)
		  :pseudo-inputs (datum datum?)
		  :crossmember-spread (the back-crossmember-spread)
		  :width (- (the width) (the base frame legs-width))
		  :length (the back-height)
		  :height (the-object (make-object (the-child plank-type)) width)
		  :display-controls (list :color :green)
		  :pass-down (recline-angle-degrees)
		  :plank-type (the back-plank-type)
		  :center
		  (if (the-child datum?) (the center)
		      (translate 
		       (flush-center
			(flush-center
			 (the-child datum center)
			 (the-child datum frame rails front (face-center :bottom))
			 (the base planking planks last (face-center :top))
			 (the (face-normal-vector :top)))
			(the-child datum frame rails front (face-center :right))
			(the base planking planks last (face-center :left))
			(the (face-normal-vector :rear)))
		       :front (the back-offset)))
		  :orientation (alignment :top (rotate-vector-d
						(the (face-normal-vector :top))
						(- 90 (the recline-angle-degrees))
						(the (face-normal-vector :right)))))))



(define-object product-process-mixin (process-mixin)


  
  )
