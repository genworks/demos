(in-package :bench)

(define-object planked-back (base-object)

  :input-slots (width length height display-controls
		      recline-angle-degrees
		      plank-type crossmember-spread)

  :computed-slots ((strings-for-display "back"))
  
  :objects
  ((frame :type 'back-frame
	  :pass-down (recline-angle-degrees crossmember-spread)
	  ;;:display-controls (list :color (if (the painted?) :brown :tan))
	  )
   
   (planking :type 'planking
	     :pass-down (plank-type)
	     :p-plane (the (face-center :top))
	     :u-plane (the (face-normal-vector :top))
	     :p-plank (the (face-center :front))
	     :u-plank (the (face-normal-vector :right))
	     :shorter-plank-indices (list 1 2)
	     :shorter-plank-length (the width)
	     :longer-plank-length (+ (the width)
				     (twice (the-object (make-object (the-child plank-type))
							width))))))


(define-object test-planked-back (planked-back)
  :computed-slots
  ((width (+ 3 56)) (length 19) (height (+ 1/2 3)) (display-controls (list :color :green))
   (recline-angle-degrees 15) (plank-type '2x4)))
