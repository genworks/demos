;;;;
;;;; Shared chrome for the public demo pages: the stylesheet hookup,
;;;; Tailwind card/form helpers, the live source-code panes, and the
;;;; standard x3dom viewport pair.  Each demo mixes this in ahead of
;;;; session-control-mixin and base-html-page and keeps only its own
;;;; page content, form controls, and model.

(in-package :demos-common)

(defvar *hack-base* nil
  "URL prefix of this host's holodeck console (e.g. \"/hack\"), or nil
when the host has none.  The deploying stack's services-init sets it;
every demo page that names its demo-slug then carries a Hack-this-demo
link opening the demo's source in a live Emacs beside a private copy
of the page.")

(defvar *url-prefix* ""
  "Prefix under which this backend's /demo/ tree is reached through the
reverse proxy -- \"\" on a production host, \"/hack\" in the holodeck,
whose copy of the demos sits at /hack/demo/<slug>.  Only the shared
stylesheet link needs it: the pages themselves are reached by their
minted /sessions/ URLs, which the proxy pins by backend.")

(define-object demo-ui-mixin ()

  :documentation
  (:description "Chrome shared by every public demo page: Tailwind
stylesheet hookup, card and parameter-field helpers, source-code panes
reconstituted live from the in-memory definitions, and a standard
x3dom viewport pair driven by the demo's objects list."
   :author "Genworks International")

  :input-slots
  (("List of define-object symbols shown in the Source Code card."
    source-pane-objects nil)
   ("List of supporting defun symbols shown after the object panes."
    source-pane-functions nil)
   ("String or nil.  The demo's slug under /demo/ (e.g. \"staircase\"),
which names it to the holodeck; nil renders no Hack-this-demo link."
    demo-slug nil)

   ;; Standard single-viewport setup; demos override the vector to
   ;; pick their hero camera angle.
   (view-projection-key :demo-view)
   (view-projection-vector (unitize-vector (make-vector 1 -1 0.5))))

  :computed-slots
  ((use-svgpanzoom? t)
   (use-x3dom? t)

   (additional-header-content
    (string-append
     (with-lhtml-string () (:script (str (the viewport-renderers-js-baseline))))
     (call-next-method)
     (with-lhtml-string ()
       (:link :href (format nil "~a/demo/css/demos-style.css" *url-prefix*)
              :rel "stylesheet" :type "text/css")
       (:script (str (the busy-overlay-js))))))

   ;; Live-on-change UX: while a section-replacing gdlAjax round-trip
   ;; is in flight, shade the page behind a click-blocking overlay so
   ;; the next edit waits until this one has propagated.  Quiet
   ;; background syncs (camera state, container size) never shade.
   ;; Mechanics: wrap window.gdlAjax to notice non-quiet calls, count
   ;; in-flight /gdlAjax XHRs, hide when the count drains.
   (busy-overlay-js "
(function () {
  var count = 0, overlay = null, nonQuiet = false;
  function ensureOverlay () {
    if (overlay) return overlay;
    overlay = document.createElement('div');
    overlay.id = 'demo-busy-overlay';
    overlay.setAttribute('style',
      'position:fixed;inset:0;z-index:9999;display:none;' +
      'background:rgba(249,250,251,0.55);backdrop-filter:blur(1px);' +
      'transition:opacity 100ms;opacity:0;');
    var pill = document.createElement('div');
    pill.setAttribute('style',
      'position:absolute;top:1.25rem;left:50%;transform:translateX(-50%);' +
      'background:#4f46e5;color:#fff;padding:0.4rem 1rem;' +
      'border-radius:9999px;font:500 0.875rem system-ui,sans-serif;' +
      'box-shadow:0 2px 8px rgba(0,0,0,0.25);');
    pill.textContent = 'Rebuilding\\u2026';
    overlay.appendChild(pill);
    document.body.appendChild(overlay);
    return overlay;
  }
  function show () {
    var el = ensureOverlay();
    if (document.activeElement && document.activeElement.blur)
      document.activeElement.blur();
    el.style.display = 'block';
    requestAnimationFrame(function () { el.style.opacity = '1'; });
  }
  function hide () {
    if (overlay) { overlay.style.opacity = '0'; overlay.style.display = 'none'; }
  }
  var origOpen = XMLHttpRequest.prototype.open;
  XMLHttpRequest.prototype.open = function (method, url) {
    this._gdlAjax = typeof url === 'string' && url.indexOf('/gdlAjax') === 0;
    return origOpen.apply(this, arguments);
  };
  var origSend = XMLHttpRequest.prototype.send;
  XMLHttpRequest.prototype.send = function () {
    if (this._gdlAjax) {
      count++;
      if (nonQuiet) { show(); nonQuiet = false; }
      this.addEventListener('loadend', function () {
        count--;
        if (count <= 0) { count = 0; hide(); }
      });
    }
    return origSend.apply(this, arguments);
  };
  window.addEventListener('DOMContentLoaded', function () {
    var orig = window.gdlAjax;
    if (!orig) return;
    window.gdlAjax = function (evt, params, asynch, quiet) {
      if (!quiet) nonQuiet = true;
      return orig.apply(this, arguments);
    };
  });
})();
")

   (source-code-panes
    (apply #'string-append
           (the (hack-banner))
           (append
            (mapcar #'(lambda (sym) (the (object-source-pane sym)))
                    (the source-pane-objects))
            (mapcar #'(lambda (sym) (the (defun-source-pane sym)))
                    (the source-pane-functions))))))

  :functions
  (;; The "All demos" back link and the page heading.
   (page-intro
    (heading blurb)
    (with-lhtml-string ()
      (:div :class "mb-4"
        (:a :href "/demos/index.html"
            :class "text-sm font-medium text-indigo-600 hover:text-indigo-500"
            "&larr; All demos"))
      (:div :class "text-center mb-8"
        (:h1 :class "text-4xl font-bold text-gray-900 mb-2" (str heading))
        (:p :class "text-lg text-gray-600" (str blurb)))))

   ;; One white card with the standard gray header band.  CONTENT is a
   ;; pre-rendered html string; wrap it yourself when it needs padding
   ;; or scrolling (e.g. "p-6", "overflow-x-auto").
   (card
    (&key title subtitle content)
    (with-lhtml-string ()
      (:div :class "bg-white rounded-lg shadow-lg overflow-hidden mb-8"
        (:div :class "px-6 py-4 bg-gray-50 border-b border-gray-200"
          (:h3 :class "text-lg font-medium text-gray-900" (str title))
          (when subtitle
            (htm (:p :class "text-sm text-gray-600" (str subtitle)))))
        (str content))))

   ;; One labeled parameter field: a form-control wrapped in the
   ;; shared label + bordered-box styling used by every parameter.
   (param-field
    (label control)
    (with-lhtml-string ()
      (:div :class "space-y-2"
        (:label :class "block text-sm font-medium text-gray-700"
                :for (the-object control id) (str label))
        (:div :class "param-field block w-full rounded-md border border-gray-300 bg-white px-3 py-2 shadow-sm"
          (str (the-object control form-control))))))

   ;; The invitation to the holodeck, heading the Source Code card:
   ;; opens this demo's source in a live Emacs (ttyd) with a private
   ;; copy of the page.  Empty where no holodeck exists (*hack-base*)
   ;; or the demo has not named itself (demo-slug).
   (hack-banner
    ()
    (if (and *hack-base* (the demo-slug))
        (with-lhtml-string ()
          (:div :class "px-6 py-3 bg-indigo-50 border-b border-indigo-100 flex items-center justify-between gap-4"
            (:p :class "text-sm text-indigo-900"
                "Want to change it?  Open this source in a live Emacs and rebuild your own copy of the page.")
            (:a :href (format nil "~a/?arg=~a" *hack-base* (the demo-slug))
                :target "_blank" :rel "noopener"
                :class "shrink-0 inline-flex items-center rounded-md bg-indigo-600 px-3 py-1.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-700"
                "Hack this demo &rarr;")))
        ""))

   ;; One collapsible pane showing a define-object, reconstituted live
   ;; from the in-memory definition.
   (object-source-pane
    (sym)
    (with-lhtml-string ()
      (:details :class "border-b border-gray-100"
        (:summary :class "px-6 py-3 cursor-pointer select-none font-mono text-sm font-medium text-indigo-700 hover:bg-gray-50"
          (fmt "(define-object ~a ...)" (the (pane-label sym))))
        (:div :class "src-pane"
          (wmd (format nil "```lisp~%~a```" (gdl:definition-source-string sym)))))))

   ;; Same, for a supporting plain function, via function-source-string
   ;; (see source-strings.lisp).  Renders nothing when no source is
   ;; recorded.
   (defun-source-pane
    (sym)
    (let ((source (function-source-string sym)))
      (if source
          (with-lhtml-string ()
            (:details :class "border-b border-gray-100"
              (:summary :class "px-6 py-3 cursor-pointer select-none font-mono text-sm font-medium text-indigo-700 hover:bg-gray-50"
                (fmt "(defun ~a ...)" (the (pane-label sym))))
              (:div :class "src-pane"
                (wmd (format nil "```lisp~%~a```" source)))))
          "")))

   ;; Package-qualify the label only when the symbol lives outside the
   ;; demo's own package.
   (pane-label
    (sym)
    (string-downcase
     (if (eq (symbol-package sym) (symbol-package (the type)))
         (symbol-name sym)
         (format nil "~a:~a"
                 (package-name (symbol-package sym)) (symbol-name sym))))))

  :objects
  ((viewport-area :type 'base-html-div
                  :div-class "absolute inset-0"
                  :js-to-eval (the view-x3dom js-to-eval)
                  :inner-html (the view-x3dom inner-html))

   (view-x3dom :type 'viewport-html-div
               :dom-id (the viewport-area dom-id)
               :image-format :x3dom
               :projection-key (the view-projection-key)
               :projection-vector (the view-projection-vector)
               :display-list-object-roots (the objects))))
