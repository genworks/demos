;;;;
;;;; Web UI on the shared demo chrome (demos-common:demo-ui-mixin):
;;;; this file keeps only the bus-specific page content, form
;;;; controls, and model hookup.  session-control-mixin keeps public
;;;; instances mortal: without it every visit and every crawler hit
;;;; mints an immortal instance.

(in-package :genworks.demos.bus)

(define-object bus-ui (demos-common:demo-ui-mixin
                       session-control-mixin base-html-page)

  :documentation
  (:description "Interactive school-bus demo page: the classic GDL bus
example hosted in the 2026 demo framework.  Steering follows the
Ackermann rule and the interior layout is governed by live design
checks -- both surfaced on the page."
   :author "Genworks International")

  :input-slots
  ((title "School Bus Demo")
   (demo-slug "bus")
   (objects (list (the model)))
   (view-projection-key :bus-view)
   (view-projection-vector (unitize-vector (make-vector 1 0.7 0.8)))

   (wheelbase 300 :settable)
   (track 96 :settable)
   (bus-height 80 :settable)
   (turn-angle 0 :settable)
   (number-of-rows 10 :settable)
   (minimum-legroom 7 :settable))

  :computed-slots
  ((source-pane-objects '(assembly chassis rule-ackermann interior
                          seating-section inter-seat-clearance-check
                          bus-ui demos-common:demo-ui-mixin))

   (body
    (with-lhtml-string ()
      (:div :class "max-w-5xl mx-auto p-8"
        (str (the (page-intro "School Bus"
                              "The classic GDL wireframe bus -- steer it, stretch it, and watch the design rules respond.")))
        (str (the (card :title "Parameters"
                        :content (with-lhtml-string ()
                                   (:div :class "p-6"
                                     (str (the control-form)))))))
        (str (the (card :title "3D View"
                        :content (with-lhtml-string ()
                                   (:div :class "p-6 relative" :style "height: 600px;"
                                     (str (the viewport-area div)))))))
        (str (the design-rules-section div))
        (str (the (card :title "Source Code"
                        :subtitle "The complete Gendl source for this demo, reconstituted live from the in-memory object definitions serving this page."
                        :content (the source-code-panes)))))))

   ;; Ajax-refreshable section: with live-on-change parameters, the
   ;; design checks re-render on every model rebuild (see
   ;; design-rules-section).
   (design-rules-card
    (the (card :title "Design Rules"
               :subtitle "Live KBE checks evaluated against the current parameters."
               :content (with-lhtml-string ()
                          (:div :class "px-6 py-4 grid grid-cols-1 md:grid-cols-2 gap-6"
                            (str (the legroom-panel))
                            (str (the overhang-panel)))
                          (:div :class "px-6 pb-6"
                            (str (the ackermann-panel)))))))

   (legroom-panel
    (let ((check (the model interior sections inter-seat-clearance-check)))
      (with-lhtml-string ()
        (:div :class "rounded-md border border-gray-200 p-4"
          (:div :class "flex items-center justify-between mb-2"
            (:h4 :class "text-sm font-semibold text-gray-900" "Legroom")
            (str (if (the-object check violated?)
                     (with-lhtml-string ()
                       (:span :class "inline-flex items-center rounded-full bg-red-100 px-2 py-1 text-xs font-semibold text-red-800"
                              "VIOLATED"))
                     (with-lhtml-string ()
                       (:span :class "inline-flex items-center rounded-full bg-green-100 px-2 py-1 text-xs font-semibold text-green-800"
                              "PASS")))))
          (:p :class "text-sm text-gray-700 tabular-nums"
              (fmt "Clear distance between seats: ~a in (minimum ~a in)"
                   (the-object check rule-result)
                   (the-object check value)))
          (:p :class "text-xs text-gray-500 mt-1"
              (str (the-object check rule-description)))))))

   (overhang-panel
    (let ((rule (the model body-frame-overhang)))
      (with-lhtml-string ()
        (:div :class "rounded-md border border-gray-200 p-4"
          (:div :class "flex items-center justify-between mb-2"
            (:h4 :class "text-sm font-semibold text-gray-900" "Body / Frame Overhang")
            (:span :class "inline-flex items-center rounded-full bg-gray-100 px-2 py-1 text-xs font-semibold text-gray-700"
                   "COMPUTED"))
          (:p :class "text-sm text-gray-700 tabular-nums"
              (fmt "Body front overhang exceeds chassis overhang by ~,1f in (target ~,1f in)"
                   (the-object rule result)
                   (the-object rule target-value)))
          (:p :class "text-xs text-gray-500 mt-1"
              (str (the-object rule rule-result-help)))))))

   (ackermann-panel
    (let* ((data (the model chassis ackermann-data))
           (lefts (getf data :left))
           (rights (getf data :right))
           (ideals (getf data :ideal-right)))
      (with-lhtml-string ()
        (:div :class "rounded-md border border-gray-200 p-4"
          (:h4 :class "text-sm font-semibold text-gray-900 mb-2" "Ackermann Steering")
          (:p :class "text-xs text-gray-500 mb-3"
              "Right-wheel turn angle for a given left-wheel angle: the actual linkage geometry vs. the Ackermann ideal.  Steer with the Turn Angle parameter and watch the front knuckles in the 3D view.")
          (:div :class "overflow-x-auto"
            (:table :class "min-w-full table-fixed divide-y divide-gray-200"
              (:thead :class "bg-gray-50"
                (:tr
                  (:th :class "px-4 py-2 text-right text-xs font-medium text-gray-500 uppercase tracking-wider" "Left (deg)")
                  (:th :class "px-4 py-2 text-right text-xs font-medium text-gray-500 uppercase tracking-wider" "Actual Right (deg)")
                  (:th :class "px-4 py-2 text-right text-xs font-medium text-gray-500 uppercase tracking-wider" "Ideal Right (deg)")))
              (:tbody :class "divide-y divide-gray-100"
                (dolist (left (list 5 10 15 20 25 30 35))
                  (let ((pos (position left lefts)))
                    (when pos
                      (htm
                       (:tr :class "hover:bg-gray-50"
                         (:td :class "px-4 py-2 text-sm text-right tabular-nums text-gray-900"
                              (fmt "~d" left))
                         (:td :class "px-4 py-2 text-sm text-right tabular-nums text-gray-700"
                              (fmt "~,2f" (nth pos rights)))
                         (:td :class "px-4 py-2 text-sm text-right tabular-nums text-gray-700"
                              (fmt "~,2f" (nth pos ideals)))))))))))))))

   (control-form
    (with-form-string (:class "grid grid-cols-2 md:grid-cols-4 gap-6")
      (str (the (param-field "Wheelbase (in)"   (the wheelbase-control))))
      (str (the (param-field "Track (in)"       (the track-control))))
      (str (the (param-field "Body Height (in)" (the height-control))))
      (str (the (param-field "Turn Angle (deg)" (the turn-angle-control))))
      (str (the (param-field "Seat Rows"        (the rows-control))))
      (str (the (param-field "Min Legroom (in)" (the legroom-control)))))))

  :objects
  ((wheelbase-control :type 'number-form-control
                      :default (the wheelbase)
                      :ajax-submit-on-change? t
                      :domain :number :min 220 :max 380 :step 10)

   (track-control :type 'number-form-control
                  :default (the track)
                  :ajax-submit-on-change? t
                  :domain :number :min 80 :max 110 :step 2)

   (height-control :type 'number-form-control
                   :default (the bus-height)
                   :ajax-submit-on-change? t
                   :domain :number :min 60 :max 100 :step 4)

   (turn-angle-control :type 'number-form-control
                       :default (the turn-angle)
                       :ajax-submit-on-change? t
                       :domain :number :min -35 :max 35 :step 5)

   (rows-control :type 'number-form-control
                 :default (the number-of-rows)
                 :ajax-submit-on-change? t
                 :domain :number :min 4 :max 14 :step 1)

   (legroom-control :type 'number-form-control
                    :default (the minimum-legroom)
                    :ajax-submit-on-change? t
                    :domain :number :min 4 :max 14 :step 1)

   (model :type 'assembly
          :wheelbase (the wheelbase-control value)
          :track (the track-control value)
          :height (the height-control value)
          :turn-angle (the turn-angle-control value)
          :number-of-rows (the rows-control value)
          :minimum-inter-seat-clearance (the legroom-control value))

   (design-rules-section :type 'base-html-div
                         :inner-html (the design-rules-card))))
