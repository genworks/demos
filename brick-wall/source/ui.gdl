;;;; -*- Mode: Lisp; Package: brick-wall-demo -*-
;;;;
;;;; Web UI on the shared demo chrome (demos-common:demo-ui-mixin):
;;;; this file keeps only the brick-wall-specific page content, form
;;;; controls, and model hookup.  session-control-mixin keeps public
;;;; instances mortal: without it every visit and every crawler hit
;;;; mints an immortal instance.

(in-package :brick-wall-demo)

(define-object brick-wall-ui (demos-common:demo-ui-mixin
                              session-control-mixin base-html-page)

  :documentation
  (:description "Interactive brick-wall demo page: bond pattern and
dimensions drive quantified sequences of courses and bricks, with the
quantity takeoff computed from the same declarative rules."
   :author "Genworks International")

  :input-slots
  ((title "Brick Wall Demo")
   (objects (list (the model)))
   (view-projection-key :wall-view)
   (view-projection-vector (unitize-vector (make-vector 0.45 -1 0.3)))

   (wall-length 96 :settable)
   (wall-height 48 :settable)
   (brick-length 8 :settable)
   (brick-height 2.5 :settable)
   (mortar-joint 0.375 :settable))

  :computed-slots
  ((source-pane-objects '(brick-wall wall-course brick-wall-ui
                          demos-common:demo-ui-mixin))

   (body
    (with-lhtml-string ()
      (:div :class "max-w-5xl mx-auto p-8"
        (str (the (page-intro "Brick Wall Pattern"
                              "Quantified sequences and pattern repetition: bond rules place every brick, and the quantity takeoff falls out for free.")))
        (str (the (card :title "Parameters"
                        :content (with-lhtml-string ()
                                   (:div :class "p-6"
                                     (str (the control-form)))))))
        (str (the (card :title "3D View"
                        :content (with-lhtml-string ()
                                   (:div :class "p-6 relative" :style "height: 520px;"
                                     (str (the viewport-area div)))))))
        (str (the (card :title "Quantity Takeoff"
                        :subtitle (format nil "Snapped to whole modules: ~,1f in long, ~,1f in tall."
                                          (float (the model effective-length))
                                          (float (the model effective-height)))
                        :content (with-lhtml-string ()
                                   (:div :class "overflow-x-auto"
                                     (str (the quantities-table)))))))
        (str (the (card :title "Source Code"
                        :subtitle "The complete Gendl source for this demo, reconstituted live from the in-memory object definitions serving this page."
                        :content (the source-code-panes)))))))

   (quantities-table
    (let ((model (the model)))
      (with-lhtml-string ()
        (:table :class "min-w-full table-fixed divide-y divide-gray-200"
          (:tbody :class "divide-y divide-gray-100"
            (dolist (row (list
                          (list "Courses" (format nil "~d" (the-object model number-of-courses)))
                          (list "Bricks per course" (format nil "~d" (the-object model bricks-per-course)))
                          (list "Full bricks" (format nil "~d" (the-object model full-brick-count)))
                          (list "Cut half-bricks" (format nil "~d" (the-object model half-brick-count)))
                          (list "Wall area" (format nil "~,1f sq ft" (the-object model wall-area-square-feet)))
                          (list "Mortar volume (est.)" (format nil "~,2f cu ft" (the-object model mortar-volume-cubic-feet)))))
              (htm
               (:tr :class "hover:bg-gray-50"
                 (:td :class "px-6 py-3 text-sm font-medium text-gray-900"
                      (str (first row)))
                 (:td :class "px-6 py-3 w-40 text-sm text-right tabular-nums text-gray-700"
                      (str (second row)))))))))))

   (control-form
    (with-form-string (:class "grid grid-cols-2 md:grid-cols-4 gap-6")
      (str (the (param-field "Wall Length (in)"   (the wall-length-control))))
      (str (the (param-field "Wall Height (in)"   (the wall-height-control))))
      (str (the (param-field "Brick Length (in)"  (the brick-length-control))))
      (str (the (param-field "Brick Height (in)"  (the brick-height-control))))
      (str (the (param-field "Mortar Joint (in)"  (the mortar-joint-control))))
      (str (the (param-field "Bond Pattern"       (the bond-control))))
      (str (the (submit-button))))))

  :objects
  ((wall-length-control :type 'number-form-control
                        :default (the wall-length)
                        :domain :number :min 24 :max 240 :step 8)

   (wall-height-control :type 'number-form-control
                        :default (the wall-height)
                        :domain :number :min 12 :max 96 :step 4)

   (brick-length-control :type 'number-form-control
                         :default (the brick-length)
                         :domain :number :min 6 :max 16 :step 1)

   (brick-height-control :type 'number-form-control
                         :default (the brick-height)
                         :domain :number :min 2 :max 5 :step 0.25)

   (mortar-joint-control :type 'number-form-control
                         :default (the mortar-joint)
                         :domain :number :min 0.25 :max 1 :step 0.125)

   (bond-control :type 'menu-form-control
                 :default :running
                 :size 1
                 :ajax-submit-on-change? t
                 :choice-plist '(:running "Running" :stack "Stack"))

   (model :type 'brick-wall
          :wall-length (the wall-length-control value)
          :wall-height (the wall-height-control value)
          :brick-length (the brick-length-control value)
          :brick-height (the brick-height-control value)
          :mortar-joint (the mortar-joint-control value)
          :bond (the bond-control value))))
