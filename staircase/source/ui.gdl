;;;; -*- Mode: Lisp; Package: staircase-demo -*-
;;;;
;;;; Web UI: base-html-page + viewport-html-div with x3dom, Tailwind
;;;; utility classes compiled into the shared /demo/css/demos-style.css
;;;; (build:demos in /projects/apps/tailwind).  session-control-mixin
;;;; keeps public instances mortal: without it every visit and every
;;;; crawler hit mints an immortal instance.

(in-package :staircase-demo)

(define-object staircase-ui (session-control-mixin base-html-page)

  :documentation
  (:description "Interactive staircase demo page: parameter form, live
x3dom viewport, and the cut list aggregated from the model's lumber
parts."
   :author "Genworks International")

  :input-slots
  ((title "Parametric Staircase Demo")
   (objects (list (the model)))

   (total-rise 96 :settable)
   (total-run 144 :settable)
   (number-of-steps 14 :settable)
   (stairs-width 36 :settable)
   (nosing 1 :settable)
   (post-every 3 :settable)
   (handrail-height 36 :settable)
   (handrail? t :settable)
   (include-risers? t :settable)
   (include-skirt? nil :settable))

  :computed-slots
  ((use-svgpanzoom? t)
   (use-x3dom? t)

   (additional-header-content
    (string-append
     (with-lhtml-string () (:script (str (the viewport-renderers-js-baseline))))
     (call-next-method)
     (with-lhtml-string ()
       (:link :href "/demo/css/demos-style.css"
              :rel "stylesheet" :type "text/css"))))

   (body
    (with-lhtml-string ()
      (:div :class "max-w-5xl mx-auto p-8"
        (:div :class "mb-4"
          (:a :href "/demos/index.html"
              :class "text-sm font-medium text-indigo-600 hover:text-indigo-500"
              "&larr; All demos"))
        (:div :class "text-center mb-8"
          (:h1 :class "text-4xl font-bold text-gray-900 mb-2"
               "Parametric Staircase")
          (:p :class "text-lg text-gray-600"
              "An outdoor staircase built entirely from parametric Gendl code -- adjust the parameters and rebuild live."))
        (:div :class "bg-white rounded-lg shadow-lg p-6 mb-8"
          (:h2 :class "text-xl font-semibold text-gray-800 mb-4" "Parameters")
          (str (the control-form)))
        (:div :class "bg-white rounded-lg shadow-lg overflow-hidden mb-8"
          (:div :class "px-6 py-4 bg-gray-50 border-b border-gray-200"
            (:h3 :class "text-lg font-medium text-gray-900" "3D View"))
          (:div :class "p-6 relative" :style "height: 600px;"
            (str (the viewport-area div))))
        (:div :class "bg-white rounded-lg shadow-lg overflow-hidden"
          (:div :class "px-6 py-4 bg-gray-50 border-b border-gray-200"
            (:h3 :class "text-lg font-medium text-gray-900" "Cut List")
            (:p :class "text-sm text-gray-600"
                (fmt "~a steps, ~,1f in rise over ~,1f in run (~,1f deg)"
                     (the number-of-steps-control value)
                     (float (the total-rise-control value))
                     (float (the total-run-control value))
                     (the model slope-angle))))
          (:div :class "overflow-x-auto"
            (str (the bom-table))))
        (:div :class "bg-white rounded-lg shadow-lg overflow-hidden mt-8"
          (:div :class "px-6 py-4 bg-gray-50 border-b border-gray-200"
            (:h3 :class "text-lg font-medium text-gray-900" "Source Code")
            (:p :class "text-sm text-gray-600"
                "The complete Gendl source for this demo: object definitions reconstituted live from the in-memory definitions serving this page, supporting lumber-system functions via the Lisp's own source records."))
          (str (the source-code-panes))))))

   (bom-table
    (with-lhtml-string ()
      (:table :class "min-w-full table-fixed divide-y divide-gray-200"
        (:thead :class "bg-gray-50"
          (:tr
            (:th :class "px-6 py-3 w-24 text-right text-xs font-medium text-gray-500 uppercase tracking-wider" "Qty")
            (:th :class "px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider" "Stock")
            (:th :class "px-6 py-3 w-40 text-right text-xs font-medium text-gray-500 uppercase tracking-wider" "Cut (in)")
            (:th :class "px-6 py-3 w-40 text-right text-xs font-medium text-gray-500 uppercase tracking-wider" "Buy (ft)")))
        (:tbody :class "divide-y divide-gray-100"
          (str (the bom-table-rows))))))

   (bom-table-rows
    (apply #'string-append
           (mapcar
            (lambda (line)
              (with-lhtml-string ()
                (:tr :class "hover:bg-gray-50"
                  (:td :class "px-6 py-3 text-sm text-right tabular-nums text-gray-900"
                       (fmt "~d" (getf line :count)))
                  (:td :class "px-6 py-3 text-sm font-medium text-gray-900"
                       (str (getf line :stock)))
                  (:td :class "px-6 py-3 text-sm text-right tabular-nums text-gray-700"
                       (fmt "~,2f" (float (getf line :cut-length))))
                  (:td :class "px-6 py-3 text-sm text-right tabular-nums text-gray-700"
                       (str (let ((buy (getf line :buy-length)))
                              (if buy (format nil "~d" (floor buy 12)) "special")))))))
            (the model bill-of-materials))))

   (source-code-panes
    (apply #'string-append
           (append
            (mapcar (lambda (sym) (the (object-source-pane sym)))
                    '(staircase tread stringer staircase-ui))
            (mapcar (lambda (sym) (the (defun-source-pane sym)))
                    '(lumber:nominal-section lumber:lumber-type
                      lumber:bill-of-materials lumber:bom-text)))))

   (control-form
    (with-form-string (:class "grid grid-cols-2 md:grid-cols-4 gap-6")
      (str (the (param-field "Total Rise (in)"     (the total-rise-control))))
      (str (the (param-field "Total Run (in)"      (the total-run-control))))
      (str (the (param-field "Number of Steps"     (the number-of-steps-control))))
      (str (the (param-field "Width (in)"          (the stairs-width-control))))
      (str (the (param-field "Nosing (in)"         (the nosing-control))))
      (str (the (param-field "Post Every (treads)" (the post-every-control))))
      (str (the (param-field "Rail Height (in)"    (the handrail-height-control))))
      (str (the (param-field "Handrail"            (the handrail-control))))
      (str (the (param-field "Risers"              (the risers-control))))
      (str (the (param-field "Skirt / Fascia"      (the skirt-control))))
      (:div :class "flex items-end col-span-2"
        (:button :type "submit"
                 :class "w-full bg-indigo-600 text-white px-4 py-2 rounded-md hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 transition-colors"
                 "Rebuild")))))

  :functions
  (;; One labeled parameter field: a form-control wrapped in the
   ;; shared label + bordered-box styling used by every parameter.
   (param-field
    (label control)
    (with-lhtml-string ()
      (:div :class "space-y-2"
        (:label :class "block text-sm font-medium text-gray-700"
                :for (the-object control id) (str label))
        (:div :class "param-field block w-full rounded-md border border-gray-300 bg-white px-3 py-2 shadow-sm"
          (str (the-object control form-control))))))

   ;; One collapsible pane showing a define-object, reconstituted live
   ;; from the in-memory definition.
   (object-source-pane
    (sym)
    (with-lhtml-string ()
      (:details :class "border-b border-gray-100"
        (:summary :class "px-6 py-3 cursor-pointer select-none font-mono text-sm font-medium text-indigo-700 hover:bg-gray-50"
          (fmt "(define-object ~(~a~) ...)" sym))
        (:div :class "src-pane"
          (wmd (format nil "```lisp~%~a```" (gdl:definition-source-string sym)))))))

   ;; Same, for a supporting plain function, via function-source-string
   ;; (see patches.lisp).  Renders nothing when no source is recorded.
   (defun-source-pane
    (sym)
    (let ((source (function-source-string sym)))
      (if source
          (with-lhtml-string ()
            (:details :class "border-b border-gray-100"
              (:summary :class "px-6 py-3 cursor-pointer select-none font-mono text-sm font-medium text-indigo-700 hover:bg-gray-50"
                (fmt "(defun ~a ...)"
                     (string-downcase
                      (if (eq (symbol-package sym)
                              (find-package :staircase-demo))
                          (symbol-name sym)
                          (format nil "~a:~a"
                                  (package-name (symbol-package sym))
                                  (symbol-name sym))))))
              (:div :class "src-pane"
                (wmd (format nil "```lisp~%~a```" source)))))
          ""))))

  :objects
  ((total-rise-control :type 'number-form-control
                       :default (the total-rise)
                       :domain :number :min 48 :max 240 :step 6)

   (total-run-control :type 'number-form-control
                      :default (the total-run)
                      :domain :number :min 60 :max 360 :step 6)

   (number-of-steps-control :type 'number-form-control
                            :default (the number-of-steps)
                            :domain :number :min 3 :max 30 :step 1)

   (stairs-width-control :type 'number-form-control
                         :default (the stairs-width)
                         :domain :number :min 24 :max 72 :step 2)

   (nosing-control :type 'number-form-control
                   :default (the nosing)
                   :domain :number :min 0 :max 2 :step 0.25)

   (post-every-control :type 'number-form-control
                       :default (the post-every)
                       :domain :number :min 2 :max 6 :step 1)

   (handrail-height-control :type 'number-form-control
                            :default (the handrail-height)
                            :domain :number :min 30 :max 42 :step 2)

   (handrail-control :type 'menu-form-control
                     :default (if (the handrail?) :yes :no)
                     :size 1
                     :ajax-submit-on-change? t
                     :choice-plist '(:yes "Yes" :no "No"))

   (risers-control :type 'menu-form-control
                   :default (if (the include-risers?) :yes :no)
                   :size 1
                   :ajax-submit-on-change? t
                   :choice-plist '(:yes "Yes" :no "No"))

   (skirt-control :type 'menu-form-control
                  :default (if (the include-skirt?) :yes :no)
                  :size 1
                  :ajax-submit-on-change? t
                  :choice-plist '(:yes "Yes" :no "No"))

   (model :type 'staircase
          :total-rise (the total-rise-control value)
          :total-run (the total-run-control value)
          :number-of-steps (the number-of-steps-control value)
          :stairs-width (the stairs-width-control value)
          :nosing (the nosing-control value)
          :post-every (the post-every-control value)
          :handrail-height (the handrail-height-control value)
          :handrail? (eq (the handrail-control value) :yes)
          :include-risers? (eq (the risers-control value) :yes)
          :include-skirt? (eq (the skirt-control value) :yes))

   (viewport-area :type 'base-html-div
                 :div-class "absolute inset-0"
                 :js-to-eval (the view-x3dom js-to-eval)
                 :inner-html (the view-x3dom inner-html))

   (view-x3dom :type 'viewport-html-div
              :dom-id (the viewport-area dom-id)
              :image-format :x3dom
              :projection-key :staircase-view
              :projection-vector (unitize-vector (make-vector 1 -0.6 0.35))
              :display-list-object-roots (the objects))))
