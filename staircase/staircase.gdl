;;;; -*- Mode: Lisp; Package: staircase-demo -*-
;;;;
;;;; Staircase demo: parametric outdoor staircase from 2x6 deckwood.
;;;;
;;;; Modeled after /projects/gendl/documentation/tutorial/examples/tower.gdl
;;;; in spirit (small, single-file, box-primitive parametric assembly).
;;;;
;;;; Inspiration: a real lakeside embankment staircase with ~14 treads,
;;;; single-side handrail, sloped grass embankment site.
;;;;
;;;; v2: stringers, risers, single-side handrail (posts + sloped rail),
;;;;     optional skirt/fascia boards. All box primitives; risers,
;;;;     handrail and skirt are individually toggleable.

(gwl:define-package :staircase-demo (:export #:staircase #:staircase-ui))
(in-package :staircase-demo)

(define-object staircase (base-object)

  :documentation
  (:description "Parametric outdoor staircase in dimensional deckwood
lumber: two sloped stringers, treads two 2x6 boards deep, optional
risers and skirt boards, and a single-side handrail on posts spaced
every few treads.  Every member is a box primitive; the
bill-of-materials slot itemizes the lumber and bom-text formats it as
a cut list."
   :author "Genworks International")

  :input-slots
  (;; Overall geometry (inches)
   (total-rise       96)    ; 8 feet vertical
   (total-run        144)   ; 12 feet horizontal
   (number-of-steps  14)
   (stairs-width     36)    ; outside-to-outside of the two stringers
   (tread-depth      11)    ; front-to-back: two 2x6 boards
   (tread-thickness  3/2)   ; actual 2x stock thickness
   (nosing           1)     ; tread overhang past the riser face

   ;; Structural lumber (actual, not nominal, dimensions)
   (stringer-thickness 3/2)  ; 2x stock thickness
   (stringer-depth     37/4) ; actual width of a 2x10 stringer
   (riser-thickness    3/2)

   ;; Optional features
   (include-risers? t :settable)
   (include-skirt?  nil :settable)
   (handrail?       t :settable)

   ;; Handrail (single side, per the reference photo)
   (post-size       7/2)  ; actual 4x4
   (post-every      3)    ; a post at every Nth tread, plus the top
   (handrail-height 36)   ; post height above the tread surface
   (rail-thickness  3/2)  ; 2x4 on edge
   (rail-depth      7/2)
   (rail-overhang   3)    ; rail run past the end posts

   (skirt-thickness 3/4))

  :computed-slots
  ((rise-per-step (/ (the total-rise) (the number-of-steps)))
   (run-per-step  (/ (the total-run)  (the number-of-steps)))

   (slope-angle  (* (/ 180 pi) (atan (the total-rise) (the total-run))))
   (slope-length (sqrt (+ (expt (the total-run) 2)
                          (expt (the total-rise) 2))))
   ;; multiply a front-to-back span by this to get its length along
   ;; the slope
   (slope-factor (/ (the slope-length) (the total-run)))

   ;; Shared tilt for anything running the length of the slope
   ;; (stringers, skirts, rail): rotate the object's own rear and top
   ;; axes about its right axis by the slope angle.
   (sloped-orientation
    (alignment :rear (rotate-vector-d (the (face-normal-vector :rear))
                                      (the slope-angle)
                                      (the (face-normal-vector :right)))
               :top  (rotate-vector-d (the (face-normal-vector :top))
                                      (the slope-angle)
                                      (the (face-normal-vector :right)))))

   (tread-length (- (the stairs-width) (* 2 (the stringer-thickness))))

   ;; centerline lateral offset of each stringer from the stair centerline
   (stringer-offset (/ (- (the stairs-width) (the stringer-thickness)) 2))

   ;; posts and rail center on this lateral offset, hugging the
   ;; outside face of one stringer
   (rail-side-offset (+ (the stringer-offset) (/ (the post-size) 2)))

   ;; Tread indices carrying a handrail post: every post-every-th,
   ;; plus the top tread so the rail never ends unsupported.
   (post-indices (let (result)
                   (dotimes (i (the number-of-steps))
                     (when (or (zerop (mod i (the post-every)))
                               (= i (1- (the number-of-steps))))
                       (push i result)))
                   (nreverse result)))

   ;; The rail spans bottom post to top post plus a little overhang,
   ;; its underside riding the post tops.
   (rail-span-y  (+ (* (1- (the number-of-steps)) (the run-per-step))
                    (the post-size)
                    (* 2 (the rail-overhang))))
   (rail-length  (* (the rail-span-y) (the slope-factor)))
   (rail-center-y (* (1- (the number-of-steps)) (/ (the run-per-step) 2)))
   (rail-center-z (+ (the (post-top-z (/ (1- (the number-of-steps)) 2)))
                     (/ (the rail-depth) 2)))

   ;; One plist per lumber line item. Cut lengths in inches;
   ;; :buy-feet is the next even-foot stock board.
   (bill-of-materials
    (append
     (list (list :item :tread-board :stock "2x6"
                 :count (* 2 (the number-of-steps))
                 :cut-length (the tread-length))
           (list :item :stringer :stock "2x10"
                 :count 2 :cut-length (the slope-length)))
     (when (the include-risers?)
       (list (list :item :riser :stock "2x8 rip"
                   :count (the number-of-steps)
                   :cut-length (the tread-length))))
     (when (the include-skirt?)
       (list (list :item :skirt :stock "1x12"
                   :count 2 :cut-length (the slope-length))))
     (when (the handrail?)
       (list (list :item :post :stock "4x4"
                   :count (length (the post-indices))
                   :cut-length (the handrail-height))
             (list :item :rail :stock "2x4"
                   :count 1 :cut-length (the rail-length))))))

   (bom-text
    (with-output-to-string (out)
      (format out "Bill of Materials: ~a steps, ~,1f in rise over ~,1f in run (~,1f deg)~%"
              (the number-of-steps) (float (the total-rise))
              (float (the total-run)) (the slope-angle))
      (format out "~4a  ~9a  ~9a  ~8a  ~a~%" "Qty" "Stock" "Cut (in)" "Buy (ft)" "Item")
      (dolist (line (the bill-of-materials))
        (format out "~4d  ~9a  ~9,1f  ~8d  ~(~a~)~%"
                (getf line :count) (getf line :stock)
                (float (getf line :cut-length))
                (* 2 (ceiling (getf line :cut-length) 24))
                (getf line :item)))))

   (display-controls (list :color :tan)))

  :functions
  ((step-y      (index) (* index (the run-per-step)))
   (tread-top-z (index) (+ (* (1+ index) (the rise-per-step))
                           (/ (the tread-thickness) 2)))
   (post-top-z  (index) (+ (the (tread-top-z index)) (the handrail-height)))

   ;; Side profile of a stringer or skirt board as a closed global
   ;; polyline in the y-z plane at lateral offset LATERAL-X: plumb
   ;; (vertical) cuts at the bottom front and at the top, a level cut
   ;; along the ground, top and underside edges parallel to the slope,
   ;; DEPTH apart measured perpendicular to the slope.  The top edge
   ;; passes through the riser-face/tread-underside corners, so the
   ;; tread-and-riser sawtooth shows above a clean plank line.
   (stringer-profile
    (lateral-x depth)
    (let* ((m (/ (the total-rise) (the total-run)))
           (c-top (+ (- (the rise-per-step) (/ (the tread-thickness) 2))
                     (* m (- (/ (the tread-depth) 2) (the nosing)))))
           (c-bot (- c-top (* depth (the slope-factor))))
           (front-y (- (the nosing) (/ (the tread-depth) 2)))
           (level-end-y (max front-y (- (/ c-bot m))))
           (top-y (+ (* (1- (the number-of-steps)) (the run-per-step))
                     (/ (the tread-depth) 2))))
      (mapcar (lambda (yz)
                (translate (the center)
                           :right lateral-x
                           :rear (first yz)
                           :up (second yz)))
              (list (list front-y 0)
                    (list level-end-y 0)
                    (list top-y (+ (* m top-y) c-bot))
                    (list top-y (+ (* m top-y) c-top))
                    (list front-y (+ (* m front-y) c-top))
                    (list front-y 0))))))

  :objects
  ((treads :type 'box
           :sequence (:size (the number-of-steps))
           :width  (the tread-length)
           :length (the tread-depth)
           :height (the tread-thickness)
           :center (translate (the center)
                              :rear (the (step-y (the-child index)))
                              :up   (- (the (tread-top-z (the-child index)))
                                       (/ (the tread-thickness) 2))))

   ;; Riser face sits nosing behind the tread front edge.
   (risers :type 'box
           :sequence (:size (if (the include-risers?) (the number-of-steps) 0))
           :width  (the tread-length)
           :length (the riser-thickness)
           :height (the rise-per-step)
           :center (translate (the center)
                              :rear (+ (the (step-y (the-child index)))
                                       (- (/ (the tread-depth) 2))
                                       (the nosing)
                                       (/ (the riser-thickness) 2))
                              :up   (* (+ (the-child index) 1/2)
                                       (the rise-per-step))))

   ;; Stringers run the slope with proper plumb and level end cuts,
   ;; extruded laterally from the side profile.
   (stringers :type 'global-polygon-projection
              :sequence (:size 2)
              :projection-depth (the stringer-thickness)
              :projection-vector (the (face-normal-vector :right))
              :vertex-list (the (stringer-profile
                                 (- (* (if (zerop (the-child index)) 1 -1)
                                       (the stringer-offset))
                                    (/ (the stringer-thickness) 2))
                                 (the stringer-depth))))

   ;; Skirt boards share the stringer profile, hung two inches deeper
   ;; on the outside faces.
   (skirts :type 'global-polygon-projection
           :sequence (:size (if (the include-skirt?) 2 0))
           :projection-depth (the skirt-thickness)
           :projection-vector (the (face-normal-vector :right))
           :vertex-list (the (stringer-profile
                              (- (* (if (zerop (the-child index)) 1 -1)
                                    (+ (the stringer-offset)
                                       (/ (+ (the stringer-thickness)
                                             (the skirt-thickness))
                                          2)))
                                 (/ (the skirt-thickness) 2))
                              (+ (the stringer-depth) 2))))

   (posts :type 'box
          :sequence (:size (if (the handrail?) (length (the post-indices)) 0))
          :width  (the post-size)
          :length (the post-size)
          :height (the handrail-height)
          :center (let ((tread-index (nth (the-child index) (the post-indices))))
                    (translate (the center)
                               :rear  (the (step-y tread-index))
                               :up    (- (the (post-top-z tread-index))
                                         (/ (the handrail-height) 2))
                               :right (the rail-side-offset))))

   (rail :type 'box
         :hidden? (not (the handrail?))
         :width  (the rail-thickness)
         :length (the rail-length)
         :height (the rail-depth)
         :orientation (the sloped-orientation)
         :center (translate (the center)
                            :rear  (the rail-center-y)
                            :up    (the rail-center-z)
                            :right (the rail-side-offset)))))


;;;; -----------------------------------------------------------------
;;;; Web UI (gold-standard pattern: base-html-page + viewport-html-div,
;;;; Tailwind CDN fallback). Kept in the same file, matching the
;;;; single-file spirit of the geometry above.
;;;; -----------------------------------------------------------------

(define-object staircase-ui (base-html-page)

  :input-slots
  ((title "Parametric Staircase Demo")
   (objects (list (the model)))

   (total-rise 96 :settable)
   (total-run 144 :settable)
   (number-of-steps 14 :settable)
   (stairs-width 36 :settable)
   (handrail? t :settable)
   (include-risers? t :settable)
   (include-skirt? nil :settable))

  :computed-slots
  ((use-svgpanzoom? t)
   (use-x3dom? t)

   (additional-header-content
    (string-append
     (with-lhtml-string () (:script (str (the viewport-renderers-js-baseline))))
     (call-next-method)))

   (body
    (with-lhtml-string ()
      (:div :class "max-w-5xl mx-auto p-8"
        (:div :class "text-center mb-8"
          (:h1 :class "text-4xl font-bold text-gray-900 mb-2"
               "Parametric Staircase")
          (:p :class "text-lg text-gray-600"
              "An outdoor staircase built entirely from parametric Gendl code -- adjust the parameters and rebuild live."))
        (:div :class "bg-white rounded-lg shadow-lg p-6 mb-8"
          (:h2 :class "text-xl font-semibold text-gray-800 mb-4" "Parameters")
          (str (the control-form)))
        (:div :class "bg-white rounded-lg shadow-lg overflow-hidden"
          (:div :class "px-6 py-4 bg-gray-50 border-b"
            (:h3 :class "text-lg font-medium text-gray-900" "3D View"))
          (:div :class "p-6 relative" :style "height: 600px;"
            (str (the viewport-area div)))))))

   (control-form
    (with-form-string (:class "grid grid-cols-2 md:grid-cols-4 gap-6")
      (:div :class "space-y-2"
            (:label :class "block text-sm font-medium text-gray-700" :for (the total-rise-control id)
                    "Total Rise (in)")
            (:div :class "block w-full rounded-md border border-gray-300 bg-white px-3 py-2 shadow-sm"
                  (str (the total-rise-control form-control))))
      (:div :class "space-y-2"
            (:label :class "block text-sm font-medium text-gray-700" :for (the total-run-control id)
                    "Total Run (in)")
            (:div :class "block w-full rounded-md border border-gray-300 bg-white px-3 py-2 shadow-sm"
                  (str (the total-run-control form-control))))
      (:div :class "space-y-2"
            (:label :class "block text-sm font-medium text-gray-700" :for (the number-of-steps-control id)
                    "Number of Steps")
            (:div :class "block w-full rounded-md border border-gray-300 bg-white px-3 py-2 shadow-sm"
                  (str (the number-of-steps-control form-control))))
      (:div :class "space-y-2"
            (:label :class "block text-sm font-medium text-gray-700" :for (the stairs-width-control id)
                    "Width (in)")
            (:div :class "block w-full rounded-md border border-gray-300 bg-white px-3 py-2 shadow-sm"
                  (str (the stairs-width-control form-control))))
      (:div :class "space-y-2"
            (:label :class "block text-sm font-medium text-gray-700" :for (the handrail-control id)
                    "Handrail")
            (:div :class "block w-full rounded-md border border-gray-300 bg-white px-3 py-2 shadow-sm"
                  (str (the handrail-control form-control))))
      (:div :class "space-y-2"
            (:label :class "block text-sm font-medium text-gray-700" :for (the risers-control id)
                    "Risers")
            (:div :class "block w-full rounded-md border border-gray-300 bg-white px-3 py-2 shadow-sm"
                  (str (the risers-control form-control))))
      (:div :class "space-y-2"
            (:label :class "block text-sm font-medium text-gray-700" :for (the skirt-control id)
                    "Skirt / Fascia")
            (:div :class "block w-full rounded-md border border-gray-300 bg-white px-3 py-2 shadow-sm"
                  (str (the skirt-control form-control))))
      (:div :class "flex items-end"
            (:button :type "submit"
                     :class "w-full bg-indigo-600 text-white px-4 py-2 rounded-md hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 transition-colors"
                     "Rebuild")))))

  :objects
  ((total-rise-control :type 'number-form-control
                       :default (the total-rise)
                       :domain :number :min 48 :max 240 :step 6)

   (total-run-control :type 'number-form-control
                      :default (the total-run)
                      :domain :number :min 60 :max 360 :step 6)

   (number-of-steps-control :type 'number-form-control
                            :default (the number-of-steps)
                            :domain :number :min 3 :max 30 :step 1)

   (stairs-width-control :type 'number-form-control
                         :default (the stairs-width)
                         :domain :number :min 24 :max 72 :step 2)

   (handrail-control :type 'menu-form-control
                     :default (if (the handrail?) :yes :no)
                     :size 1
                     :ajax-submit-on-change? t
                     :choice-plist '(:yes "Yes" :no "No"))

   (risers-control :type 'menu-form-control
                   :default (if (the include-risers?) :yes :no)
                   :size 1
                   :ajax-submit-on-change? t
                   :choice-plist '(:yes "Yes" :no "No"))

   (skirt-control :type 'menu-form-control
                  :default (if (the include-skirt?) :yes :no)
                  :size 1
                  :ajax-submit-on-change? t
                  :choice-plist '(:yes "Yes" :no "No"))

   (model :type 'staircase
          :total-rise (the total-rise-control value)
          :total-run (the total-run-control value)
          :number-of-steps (the number-of-steps-control value)
          :stairs-width (the stairs-width-control value)
          :handrail? (eq (the handrail-control value) :yes)
          :include-risers? (eq (the risers-control value) :yes)
          :include-skirt? (eq (the skirt-control value) :yes))

   (viewport-area :type 'base-html-div
                 :div-class "absolute inset-0"
                 :js-to-eval (the view-x3dom js-to-eval)
                 :inner-html (the view-x3dom inner-html))

   (view-x3dom :type 'viewport-html-div
              :dom-id (the viewport-area dom-id)
              :image-format :x3dom
              :projection-key :trimetric
              :display-list-objects (the objects))))

(gwl:with-all-servers (server)
  (gwl:publish-gwl-app "/staircase" 'staircase-ui :server server))
